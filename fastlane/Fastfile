default_platform(:mac)

def require_ci_artifact_build!(command_name)
  return if ENV["NAVIA_ALLOW_LOCAL_APP_BUILD"] == "1"

  UI.user_error!(<<~MSG)
    Navia local app build/release/open/install command blocked: #{command_name}

    Signed/testable Navia.app artifacts must come from GitHub Actions, not local app builds.
    Use the GitHub Actions artifact instead.
    Commit and push the change, wait for .github/workflows/macos-build.yml, then download
    and install the Navia-macOS-signed-notarized-app artifact.

    Set NAVIA_ALLOW_LOCAL_APP_BUILD=1 only for intentional human recovery/development;
    agents must not use that override for completion verification.
  MSG
end

platform :mac do

  lane :dev do
    require_ci_artifact_build!("bundle exec fastlane dev")
  end

  lane :release do
    require_ci_artifact_build!("bundle exec fastlane release")

    # check_apple_agreement(
    #   apple_id: ENV["FASTLANE_APPLE_ID"],
    #   password: ENV["FASTLANE_PORTAL_PASSWORD"]
    # )

    Dir.chdir("..") do
      sh("bun", "bump")
    end

    version = get_version_number(xcodeproj: "./macos/sol.xcodeproj")

    path = "/Users/osp/Developer/sol/"
    appFileName = path + "Navia.app"
    zipFileName = path + "releases/" + version + ".zip"
    
    gym(
      scheme: "release",
      configuration: "Release",
      clean: true,
      workspace: "./macos/sol.xcworkspace",
      output_directory: path,
      export_method: "developer-id"
    )

    notarize(
      package: appFileName,
      bundle_id: "com.tingkaichiu.navia",
      username: ENV["FASTLANE_APPLE_ID"],
      asc_provider: "24CMR7378R"
    )

    zip(
      path: appFileName,
      output_path: zipFileName,
      symlinks: true
    )

    set_github_release(
      repository_name: ENV.fetch("GITHUB_REPOSITORY", "tingkaichiu/navia"),
      api_token: ENV["GITHUB_API_TOKEN"],
      tag_name: version,
      is_generate_release_notes: true,
      upload_assets: [zipFileName]
    )

    release_notes = lane_context[SharedValues::SET_GITHUB_RELEASE_JSON]["body"]

    file_url = "https://github.com/tingkaichiu/navia/releases/download/" + version + "/" + version + ".zip"
    
    
    Dir.chdir("..") do
      sh("./macos/Pods/Sparkle/bin/generate_appcast", "releases")

      sh("./scripts/appcast.js", file_url, version, release_notes)

      Dir.glob("#{path}releases/*.zip").each { |file| File.delete(file) }

      sh("git", "add", ".")
      sh("git", "commit", "-m", version)
      sh("git", "push")
    end

    sh("cp", "-R", appFileName, "/Applications/")

    sh("open", "/Applications/Navia.app")

    sh("pingme", "Navia " + version + " released")
  end
end
